#set MassCut:MinM 1.*GeV	
#set LeptonKtCut:MinKT 1.0*GeV
#set LeptonKtCut:MaxEta 5.
#set LeptonKtCut:MinEta -5.



## QCD 2-2 scattering
#############################
insert SimpleQCD:MatrixElements[0] MEQCD2to2
cd /Herwig/Cuts
set JetKtCut:MinKT 10.0*GeV
set QCDCuts:MHatMin 20.0*GeV



